# --- required ---
COMPOSIO_API_KEY=

# --- search / scrape provider (set exactly one; Exa is the default) ---
SEARCH_PROVIDER=exa
EXA_API_KEY=
TAVILY_API_KEY=
FIRECRAWL_API_KEY=

# --- model transport ---
# opencode = use the locally configured OpenCode runner (no model key needed)
# openai_compatible = call OPENAI_BASE_URL with OPENAI_API_KEY
LLM_BACKEND=opencode
RESEARCHER_MODEL=opencode/deepseek-v4.1-flash
VERIFIER_MODEL=opencode/gemini-3.8-flash

# Only needed when LLM_BACKEND=openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- pipeline ---
CONCURRENCY=4
TOOL_CONCURRENCY=4
MAX_TOOL_CALLS_PER_APP=25
MAX_PAGES_PER_APP=10
PAGE_CHAR_BUDGET=5000
EVIDENCE_CHAR_BUDGET=45000
EXA_MAX_AGE_HOURS=24
MAX_REVISION_ROUNDS=2
QUOTE_FUZZY_THRESHOLD=0.90
RESULTS_DIR=results
DATA_DIR=data
